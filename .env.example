# =============================================================================
# Speed Climbing Performance Analysis - Environment Variables
# =============================================================================
# Copy this file to .env and configure your settings
#
# For Coolify deployment: Set these in Coolify UI > Environment Variables
# For local development: Copy to .env and modify
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Environment: development | production
APP_ENV=production

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Streamlit Configuration
# -----------------------------------------------------------------------------

# Server port (default: 8501)
STREAMLIT_SERVER_PORT=8501

# Server address (MUST be 0.0.0.0 for Docker/Coolify)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Run in headless mode (no browser auto-open)
STREAMLIT_SERVER_HEADLESS=true

# Disable usage statistics
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# -----------------------------------------------------------------------------
# Data Paths (Optional - defaults work in Docker)
# -----------------------------------------------------------------------------

# Path to data directory
# DATA_DIR=/app/data

# Path to configs directory
# CONFIG_DIR=/app/configs

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------

# Enable debug mode
# DEBUG_MODE=false

# Enable experimental features
# EXPERIMENTAL_FEATURES=false

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------

# If using external storage for videos
# VIDEO_STORAGE_URL=

# If using external API for additional analysis
# EXTERNAL_API_URL=
# EXTERNAL_API_KEY=
